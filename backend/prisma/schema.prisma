generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  description   String?
  status        String        @default("ACTIVE") // ACTIVE, INACTIVE
  subCategories SubCategory[]
  products      Product[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model SubCategory {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  code        String?   // e.g. CT001, CT002
  description String?
  image       String?
  status      String    @default("ACTIVE") // ACTIVE, INACTIVE
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Brand {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  image       String?
  status      String    @default("ACTIVE") // ACTIVE, INACTIVE
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Unit {
  id          String    @id @default(uuid())
  name        String
  shortName   String    @unique // e.g. kg, L, pcs
  status      String    @default("ACTIVE") // ACTIVE, INACTIVE
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Warranty {
  id          String   @id @default(uuid())
  name        String
  description String?
  duration    String   // e.g. "2 Year", "6 Months"
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VariantAttribute {
  id        String   @id @default(uuid())
  name      String
  values    String   // e.g. "XS, S, M, L, XL"
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Warehouse {
  id            String    @id @default(uuid())
  name          String
  contactPerson String?
  contactAvatar String?
  phone         String?
  totalProducts Int       @default(0)
  stock         Int       @default(0)
  qty           Int       @default(0)
  code          String?
  address       String?
  status        String          @default("ACTIVE") // ACTIVE, INACTIVE
  products      Product[]
  productStocks ProductStock[]
  stockMovements StockMovement[]
  userWarehouses UserWarehouse[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Store {
  id        String    @id @default(uuid())
  name      String
  userName  String?
  email     String?
  phone     String?
  code      String?
  address   String?
  status    String    @default("ACTIVE") // ACTIVE, INACTIVE
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Supplier {
  id        String   @id @default(uuid())
  code      String?  @unique
  name      String
  image     String?
  email     String?
  phone     String?
  country   String?
  address   String?
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Biller {
  id          String   @id @default(uuid())
  code        String?  @unique
  name        String
  avatar      String?
  companyName String?
  email       String?
  phone       String?
  country     String?
  address     String?
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Shift {
  id        String   @id @default(uuid())
  name      String
  timing    String
  weekOff   String
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id           String   @id @default(uuid())
  name         String
  headName     String?
  headAvatar   String?
  totalMembers Int      @default(0)
  status       String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Designation {
  id           String   @id @default(uuid())
  name         String
  department   String
  totalMembers Int      @default(0)
  status       String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Employee {
  id         String   @id @default(uuid())
  empId      String?  @unique
  name       String
  avatar     String?
  role       String?
  department String?
  email      String?
  phone      String?
  joinedDate String?
  status     String   @default("ACTIVE") // ACTIVE, INACTIVE, NEW_JOINER
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Attendance {
  id             String   @id @default(uuid())
  employeeId     String?
  employeeName   String?  @default("John Smilga")
  employeeRole   String?
  employeeAvatar String?
  date           String   // "01 Jan 2026"
  status         String   @default("PRESENT") // PRESENT, ABSENT, HOLIDAY, HALF_DAY, LATE
  clockIn        String?
  clockOut       String?
  production     String?
  breakTime      String?
  overtime       String?
  totalHours     String?
  progress       Int?     @default(100)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model LeaveType {
  id        String   @id @default(uuid())
  name      String
  quota     Int      @default(5)
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Leave {
  id             String   @id @default(uuid())
  empCode        String?  // "EMP001"
  employeeName   String?
  employeeRole   String?
  employeeAvatar String?
  leaveType      String   // "Sick Leave"
  fromDate       String   // "24 Dec 2024"
  toDate         String   // "24 Dec 2024"
  duration       String   @default("01 Day") // "01 Day", "02 hrs"
  appliedOn      String   // "23 Dec 2024"
  shift          String?  @default("Regular")
  reason         String?
  status         String   @default("APPROVED") // APPROVED, REJECTED, APPLIED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Holiday {
  id          String   @id @default(uuid())
  name        String   // e.g. "New Year", "Martin Luther King Jr. Day"
  date        String   // "01 Jan 2026"
  description String?
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payroll {
  id              String   @id @default(uuid())
  empCode         String   // "EMP001"
  employeeName    String   // "Carl Evans"
  employeeRole    String   // "Designer"
  employeeAvatar  String?  // "/assets/images/customer11.jpg"
  email           String   // "carlevans@example.com"
  salary          Float    @default(30000)
  basicSalary     Float    @default(30000)
  hra             Float    @default(0)
  conveyance      Float    @default(0)
  medical         Float    @default(0)
  bonus           Float    @default(0)
  pf              Float    @default(0)
  professionalTax Float    @default(0)
  tds             Float    @default(0)
  loans           Float    @default(0)
  payPeriod       String   @default("Jan 2026")
  location        String   @default("USA")
  status          String   @default("PAID") // PAID, UNPAID
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SalesReportItem {
  id          String   @id @default(uuid())
  sku         String   // "PT001"
  productName String   // "Lenovo IdeaPad 3"
  productImage String? // "/assets/images/product-01.jpg"
  brand       String   // "Lenovo"
  category    String   // "Computers"
  soldQty     Int      @default(5)
  soldAmount  Float    @default(3000)
  instockQty  Int      @default(100)
  store       String   @default("All")
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PurchaseReportItem {
  id             String   @id @default(uuid())
  reference      String   @default("PO2026")
  sku            String   // "PT001"
  dueDate        String   // "24 Dec 2024"
  productName    String   // "Lenovo IdeaPad 3"
  productImage   String?  // "/assets/images/product-01.jpg"
  category       String   // "Computers"
  instockQty     Int      @default(100)
  purchaseQty    Int      @default(5)
  purchaseAmount Float    @default(500)
  store          String   @default("All")
  date           DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model InventoryReportItem {
  id           String   @id @default(uuid())
  sku          String   // "PT001"
  productName  String   // "Lenovo IdeaPad 3"
  productImage String?  // "/assets/images/product-01.jpg"
  category     String   // "Computers"
  unit         String   @default("Pc")
  instockQty   Int      @default(100)
  minStock     Int      @default(10)
  stockValue   Float    @default(3000)
  store        String   @default("All")
  date         DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StockHistoryItem {
  id                String   @id @default(uuid())
  sku               String   // "PT001"
  productName       String   // "Lenovo IdeaPad 3"
  productImage      String?  // "/assets/images/product-01.jpg"
  initialQuantity   Int      @default(6000)
  addedQuantity     Int      @default(100)
  soldQuantity      Int      @default(100)
  defectiveQuantity Int      @default(100)
  finalQuantity     Int      @default(100)
  category          String   @default("All")
  store             String   @default("All")
  date              DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SoldStockItem {
  id           String   @id @default(uuid())
  sku          String   // "PT001"
  productName  String   // "Lenovo IdeaPad 3"
  productImage String?  // "/assets/images/product-01.jpg"
  unit         Int      @default(6000)
  quantity     Int      @default(100)
  taxValue     Float    @default(300)
  total        Float    @default(300)
  category     String   @default("All")
  store        String   @default("All")
  date         DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model InvoiceReportItem {
  id         String   @id @default(uuid())
  invoiceNo  String   // "INV001"
  customer   String   // "Carl Evans"
  dueDate    String   // "24 Dec 2024"
  amount     Float    @default(500)
  paid       Float    @default(500)
  amountDue  Float    @default(500)
  status     String   @default("PAID") // PAID, UNPAID
  date       DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SupplierReportItem {
  id            String   @id @default(uuid())
  reference     String   // "INV/PO2026"
  supplierId    String   // "SU001"
  supplierName  String   // "Apex Computers"
  supplierImage String?  // "/assets/images/product-01.jpg"
  totalItems    Int      @default(10)
  amount        Float    @default(1000)
  paymentMethod String   @default("Cash")
  status        String   @default("RECEIVED") // RECEIVED, PENDING, ORDERED
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SupplierDueReportItem {
  id            String   @id @default(uuid())
  reference     String   // "INV/PO2026"
  supplierId    String   // "SU001"
  supplierName  String   // "Apex Computers"
  supplierImage String?  // "/assets/images/product-01.jpg"
  totalAmount   Float    @default(1000)
  paid          Float    @default(1000)
  due           Float    @default(0)
  status        String   @default("PAID") // PAID, OVERDUE, UNPAID
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CustomerReportItem {
  id            String   @id @default(uuid())
  reference     String   // "INV2026"
  customerCode  String   // "CU001"
  customerName  String   // "Carl Evans"
  customerImage String?  // "/assets/images/customer11.jpg"
  totalOrders   Int      @default(10)
  amount        Float    @default(1000)
  paymentMethod String   @default("Cash")
  status        String   @default("COMPLETED")
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CustomerDueReportItem {
  id            String   @id @default(uuid())
  reference     String   // "INV2026"
  customerCode  String   // "CU001"
  customerName  String   // "Carl Evans"
  customerImage String?  // "/assets/images/customer11.jpg"
  totalAmount   Float    @default(1000)
  paid          Float    @default(1000)
  due           Float    @default(0)
  status        String   @default("PAID") // PAID, OVERDUE, UNPAID, COMPLETED
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProductReportItem {
  id           String   @id @default(uuid())
  sku          String   // "PT001"
  productName  String   // "Lenovo IdeaPad 3"
  productImage String?  // "/assets/images/product-01.jpg"
  category     String   // "Computers"
  brand        String   // "Lenovo"
  qty          Int      @default(100)
  price        Float    @default(600)
  totalOrdered Int      @default(5000)
  revenue      Float    @default(787258)
  store        String   @default("All")
  date         DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProductExpiryReportItem {
  id               String   @id @default(uuid())
  sku              String   // "PT001"
  serialNo         String   @default("LNV-IP3-8GB-256SSD-BL")
  productName      String   // "Lenovo IdeaPad 3"
  productImage     String?  // "/assets/images/product-01.jpg"
  manufacturedDate String   // "24 Dec 2024"
  expiredDate      String   // "20 Dec 2026"
  store            String   @default("All")
  category         String   @default("All")
  brand            String   @default("All")
  date             DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ProductQuantityAlertItem {
  id            String   @id @default(uuid())
  sku           String   // "PT001"
  serialNo      String   @default("LNV-IP3-8GB-256SSD-BL")
  productName   String   // "Lenovo IdeaPad 3"
  productImage  String?  // "/assets/images/product-01.jpg"
  totalQuantity Int      @default(98)
  alertQuantity Int      @default(79)
  store         String   @default("All")
  category      String   @default("All")
  brand         String   @default("All")
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ExpenseReportItem {
  id            String   @id @default(uuid())
  expenseName   String   // "Electricity Payment"
  category      String   // "Utilities"
  description   String   // "Electricity Bill"
  expenseDate   String   // "24 Dec 2024"
  amount        Float    @default(200)
  paymentMethod String   @default("Cash")
  status        String   @default("APPROVED") // APPROVED, PENDING
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model IncomeReportItem {
  id            String   @id @default(uuid())
  incomeName    String   // "Product Sales"
  category      String   // "Sales"
  description   String   // "Monthly store sales"
  incomeDate    String   // "24 Dec 2024"
  amount        Float    @default(4565)
  paymentMethod String   @default("Cash")
  status        String   @default("RECEIVED") // RECEIVED, PENDING
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PurchaseTaxReportItem {
  id            String   @id @default(uuid())
  reference     String   // "#4237300"
  supplier      String   // "Apex Computers"
  taxDate       String   // "24 Dec 2024"
  store         String   // "Electro Mart"
  amount        Float    @default(200)
  paymentMethod String   @default("Stripe")
  discount      Float    @default(200)
  taxAmount     Float    @default(200)
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SalesTaxReportItem {
  id            String   @id @default(uuid())
  reference     String   // "#4237300"
  customer      String   // "Apex Computers"
  taxDate       String   // "24 Dec 2024"
  store         String   // "Electro Mart"
  amount        Float    @default(200)
  paymentMethod String   @default("Stripe")
  discount      Float    @default(200)
  taxAmount     Float    @default(200)
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProfitLossReportItem {
  id        String   @id @default(uuid())
  type      String   // "INCOME" or "EXPENSE"
  itemKey   String   // "Sales", "Service", "Purchase Return", "Purrchase", "Sales Return"
  jan2026   Float    @default(50000)
  feb2026   Float    @default(50000)
  mar2026   Float    @default(50000)
  apr2026   Float    @default(50000)
  may2026   Float    @default(50000)
  jun2026   Float    @default(50000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AnnualReportItem {
  id        String   @id @default(uuid())
  monthName String   // "January", "Febuary", "March"...
  jan2026   Float    @default(50000)
  feb2026   Float    @default(50000)
  mar2026   Float    @default(50000)
  apr2026   Float    @default(50000)
  year      Int      @default(2026)
  store     String   @default("All Stores")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockTransfer {
  id                 String   @id @default(uuid())
  fromWarehouse      String
  toWarehouse        String
  noOfProducts       Int      @default(1)
  quantityTransferred Int     @default(1)
  refNumber          String   @unique
  date               DateTime @default(now())
  status             String   @default("COMPLETED") // COMPLETED, PENDING, CANCELLED
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model StockAdjustment {
  id           String   @id @default(uuid())
  warehouse    String
  store        String
  productName  String
  productImage String?
  date         DateTime @default(now())
  personName   String   @default("James Kirwin")
  personAvatar String?
  qty          Int      @default(0)
  type         String   @default("ADDITION") // ADDITION, SUBTRACTION
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id               String      @id @default(uuid())
  name             String
  sku              String      @unique
  barcode          String?     @unique
  description      String?
  price            Float
  costPrice        Float       @default(0.0)
  stock            Int         @default(0)
  minStockAlert    Int         @default(5)
  image            String?
  status           String      @default("ACTIVE") // ACTIVE, INACTIVE, OUT_OF_STOCK
  manufacturedDate DateTime?
  expiredDate      DateTime?
  
  categoryId       String?
  category         Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  brandId          String?
  brand            Brand?      @relation(fields: [brandId], references: [id], onDelete: SetNull)
  
  unitId           String?
  unit             Unit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)

  warehouseId      String?
  warehouse        Warehouse?  @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  storeId          String?
  store            Store?          @relation(fields: [storeId], references: [id], onDelete: SetNull)

  stocks           ProductStock[]
  movements        StockMovement[]
  orderItems       OrderItem[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Customer {
  id          String   @id @default(uuid())
  code        String?  @unique
  name        String
  phone       String?
  email       String?
  avatar      String?
  country     String?
  city        String?
  address     String?
  points      Int      @default(0)
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shiftId       String?
  shift         PosShift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  subtotal      Float
  discount      Float       @default(0.0)
  tax           Float       @default(0.0)
  total         Float
  paymentMethod String      @default("CASH") // CASH, PROMPTPAY, CREDIT_CARD
  paymentStatus String      @default("PAID") // PAID, PENDING, CANCELLED
  cashierName   String      @default("Admin")
  notes         String?
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Int
  unitPrice   Float
  subtotal    Float
  createdAt   DateTime @default(now())
}

model SystemUser {
  id            String   @id @default(uuid())
  name          String
  phone         String?
  email         String   @unique
  role          String   @default("Admin")
  warehouseName String?  // e.g. "Lavish Warehouse"
  storeName     String?  // e.g. "ElectroMart Main"
  avatar        String?  @default("/assets/images/customer11.jpg")
  status        String   @default("ACTIVE") // ACTIVE, INACTIVE
  password      String?
  assignedWarehouses UserWarehouse[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UserWarehouse {
  id          String     @id @default(uuid())
  userId      String
  user        SystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@unique([userId, warehouseId])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  permissions String?  // JSON string representing module permissions
  createdDate String?  // e.g. "12 Sep 2024"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DeleteAccountRequest {
  id                String   @id @default(uuid())
  userName          String
  userAvatar        String?  @default("/assets/images/customer11.jpg")
  requisitionDate   String   // e.g. "25 Sep 2023"
  deleteRequestDate String   // e.g. "01 Oct 2023"
  status            String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model UserProfileSettings {
  id          String   @id @default(uuid())
  firstName   String   @default("John")
  lastName    String   @default("Doe")
  email       String   @default("john.doe@example.com")
  phone       String   @default("+1 555-0199")
  userName    String   @default("johndoe")
  address     String   @default("123 Business Avenue, Suite 100")
  city        String   @default("New York")
  country     String   @default("United States")
  postalCode  String   @default("10001")
  bio         String   @default("Super Administrator & Store Manager")
  avatar      String   @default("/assets/images/customer11.jpg")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserSecuritySettings {
  id                  String   @id @default(uuid())
  twoFactorEnabled    Boolean  @default(true)
  twoFactorMethod     String   @default("Authenticator App") // Authenticator App, SMS
  passwordLastChanged String   @default("2 months ago")
  loginAlerts         Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model UserSessionLog {
  id         String   @id @default(uuid())
  device     String   // "MacBook Pro (16-inch)"
  browser    String   // "Chrome 120.0 (macOS)"
  ipAddress  String   // "192.168.1.102"
  location   String   // "New York, USA"
  lastActive String   // "Current Session"
  isCurrent  Boolean  @default(false)
