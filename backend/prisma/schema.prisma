model PosShift {
  id                  String             @id @default(uuid())
  shiftNumber         String             @unique // e.g. SFT-20261006-001
  cashierName         String             @default("Admin")
  cashierId           String?
  storeName           String             @default("Electro Mart")
  openingFloat        Float              @default(0.0) // เงินทอนเริ่มต้น
  status              String             @default("OPEN") // "OPEN", "CLOSED"
  openedAt            DateTime           @default(now())
  closedAt            DateTime?
  closingCashCounted  Float?             // เงินสดที่นับได้ตอนปิดกะ
  expectedCash        Float?             // เงินทอน + ยอดขายเงินสด + payIn - payOut
  cashVariance        Float?             // closingCashCounted - expectedCash (เกิน/ขาด)
  totalCashSales      Float              @default(0.0)
  totalPromptPaySales Float              @default(0.0)
  totalCardSales      Float              @default(0.0)
  totalSales          Float              @default(0.0)
  orderCount          Int                @default(0)
  cashIn              Float              @default(0.0) // Pay In (นำเงินสดเข้าลิ้นชัก)
  cashOut             Float              @default(0.0) // Pay Out (หยิบเงินสดออกจากลิ้นชัก)
  notes               String?
  orders              Order[]
  movements           PosShiftMovement[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

